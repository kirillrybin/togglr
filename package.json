{
  "name": "@kirillrybin/togglr",
  "version": "0.6.0",
  "description": "A CLI + terminal UI for Toggl Track, built to stay well under the API rate limit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirillrybin/togglr.git"
  },
  "keywords": [
    "toggl",
    "toggl-track",
    "time-tracking",
    "cli",
    "tui"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "toggl": "dist/cli.js",
    "togglr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
